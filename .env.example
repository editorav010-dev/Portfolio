# ── Resend (server-side only — NEVER prefix with VITE_ / never import in frontend code)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender identity MUST be verified in your Resend account.
# For quick testing Resend provides a shared test sender (delivers only to YOUR verified email):
RESEND_FROM=Portfolio Signal <onboarding@resend.dev>
# For production replace with an address on a domain you verified in Resend, e.g.:
# RESEND_FROM=Anmol Verma <hello@yourdomain.com>

# Where form submissions are delivered:
CONTACT_TO=anmolverma.env@gmail.com

# ── React Bits Pro registry (used only by `npx shadcn` CLI at install time, not at runtime)
REACTBITS_LICENSE_KEY=rbpk-your-license-key-here
